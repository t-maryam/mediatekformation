{% extends "baseadmin.html.twig" %}

{% block body %}
<div class="container mt-4">
    <h2 class="mb-4 text-primary">
        {% if playlist.id %}Modifier{% else %}Ajouter{% endif %} une playlist
    </h2>
    
    {{ form_start(formplaylist) }}
    
    <div class="row">
        <div class="col-md-12">
            <div class="mb-3">
                {{ form_label(formplaylist.name) }}
                {{ form_widget(formplaylist.name) }}
                <div class="text-danger">{{ form_errors(formplaylist.name) }}</div>
            </div>
            
            <div class="mb-3">
                {{ form_label(formplaylist.description) }}
                {{ form_widget(formplaylist.description) }}
                <div class="text-danger">{{ form_errors(formplaylist.description) }}</div>
            </div>
        </div>
    </div>
    
    <div class="row mt-3">
        <div class="col">
            {{ form_widget(formplaylist.submit) }}
        </div>
    </div>
    
    {{ form_end(formplaylist) }}

    {% if playlist.formations is defined and playlist.formations|length > 0 %}
        <hr class="mt-5">
        <h4 class="text-info">Formations incluses dans cette playlist :</h4>
        <div class="mt-3">
            <ul class="list-group">
                {% for formation in playlist.formations %}
                    <li class="list-group-item">
                        <strong>{{ formation.title }}</strong> 
                        <span class="text-muted">({{ formation.publishedAt|date("d/m/Y") }})</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% elseif playlist.id %}
        <hr class="mt-5">
        <p class="text-muted">Aucune formation rattachée à cette playlist pour le moment.</p>
    {% endif %}
</div>
{% endblock %}